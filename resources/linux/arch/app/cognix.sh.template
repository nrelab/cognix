#!/bin/bash

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-~/.config}

# Allow users to override command-line options
if [[ -f $XDG_CONFIG_HOME/cognix-terminal@@CHANNEL_SUFFIX@@-flags.conf ]]; then
    COGNIX_USER_FLAGS="$(grep -v '^#' $XDG_CONFIG_HOME/cognix-terminal@@CHANNEL_SUFFIX@@-flags.conf)"
fi

# Launch
exec /opt/nrelab/cognix-terminal@@CHANNEL_SUFFIX@@/@@BINARY_NAME@@ $COGNIX_USER_FLAGS "$@"
