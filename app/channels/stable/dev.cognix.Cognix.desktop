[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Cognix
GenericName=TerminalEmulator

Exec=cognix-terminal %U
StartupWMClass=dev.cognix.Cognix

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.cognix.Cognix

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for cognix:// URLs.
MimeType=x-scheme-handler/cognix;
