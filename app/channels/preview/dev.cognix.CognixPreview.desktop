[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=CognixPreview
GenericName=TerminalEmulator

Exec=cognix-terminal-preview %U
StartupWMClass=dev.cognix.CognixPreview

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.cognix.CognixPreview

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for cognixpreview:// URLs.
MimeType=x-scheme-handler/cognixpreview;
