[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=CognixDev
GenericName=TerminalEmulator

Exec=cognix-terminal-dev %U
StartupWMClass=dev.cognix.CognixDev

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.cognix.CognixDev

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for cognixdev:// URLs.
MimeType=x-scheme-handler/cognixdev;
