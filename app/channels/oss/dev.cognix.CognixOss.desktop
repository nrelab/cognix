[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=CognixOss
GenericName=TerminalEmulator

Exec=cognix-oss %U
StartupWMClass=dev.cognix.CognixOss

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.cognix.CognixOss

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for cognixoss:// URLs.
MimeType=x-scheme-handler/cognixoss;
